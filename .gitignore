# -------------------------------------------------------------------------
# Vivado Project & Run Artifacts (FPGA / Xilinx Spartan-7)
# -------------------------------------------------------------------------
.Xil/
*.runs/
*.cache/
*.hw/
*.sim/
*.ip_user_files/

# Vivado log and journal files
vivado*.log
vivado*.jou
vivado*.str
vivado_pid*.str
vivado_*.backup.*
dfx_runtime.txt
webtalk*.xml
webtalk*.log

# Simulation temporary files
xsim.dir/
*.wdb
*.pb
*.vcd
*.wcfg.bak

# Whitelist all source files in srcs
!*.srcs/**

# -------------------------------------------------------------------------
# STM32CubeIDE Build Output (Firmware / Bare-Metal C)
# -------------------------------------------------------------------------
Debug/
Release/
*.o
*.d
*.su
*.cyclo
*.elf
*.bin
*.map
*.hex

# -------------------------------------------------------------------------
# KiCad EDA Artifacts & Backups (PCB & Schematics)
# -------------------------------------------------------------------------
*.kicad_pcb-bak
*.kicad_sch-bak
*.bak
*.backup
*.pre_opt
*.lck
~*
_autosave-*
*.autosave
fp-info-cache

# -------------------------------------------------------------------------
# LTspice Simulation Outputs & Transient Data
# -------------------------------------------------------------------------
*.raw
*.log
*.op.raw
*.fft
*.net

# -------------------------------------------------------------------------
# LabVIEW & MATLAB Temporary / Autosave Files
# -------------------------------------------------------------------------
*.aliases
*.lvlps
*.asv
*.m~

# -------------------------------------------------------------------------
# Documentation Policy — Reference Links Only (No Third-Party PDFs)
# -------------------------------------------------------------------------
# Prevent committing large third-party PDF manuals/datasheets in docs/
docs/*.pdf

# -------------------------------------------------------------------------
# OS & Editor Generated Files
# -------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.vscode/
.history/
